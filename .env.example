# Paint Shop Backend Environment Configuration

PORT=5001

# MySQL Database Configuration (Aiven / Local)
DB_HOST=mysql-xxxxx.aivencloud.com
DB_PORT=21764
DB_USER=avnadmin
DB_PASSWORD=your_aiven_db_password
DB_NAME=defaultdb

# SSL Configuration (Set to true for Aiven)
DB_SSL=true
# Optional path or certificate content:
# DB_SSL_CA=certs/aiven-ca.pem

# Authentication & Admin Setup
JWT_SECRET=paint_shop_super_secret_jwt_key_2025
ADMIN_EMAIL=admin@paintshop.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Shop Admin
